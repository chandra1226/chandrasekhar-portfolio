# ---------------------------------------------------------------------------
# All values here are OPTIONAL. The portfolio builds and runs with none of them.
# Copy this file to `.env.local` if you want to override a default.
# `.env.local` is git-ignored — never commit real secrets.
# ---------------------------------------------------------------------------

# Canonical production URL, used for SEO metadata, sitemap.xml and robots.txt.
# Set this once you know your final domain, e.g. https://chandrasekhar.dev
NEXT_PUBLIC_SITE_URL=https://chandra1226.github.io/chandrasekhar-portfolio

# Sub-path the site is served from. Leave EMPTY for Vercel / Netlify / a custom
# domain. The GitHub Pages workflow sets this automatically to "/<repo-name>".
NEXT_PUBLIC_BASE_PATH=
